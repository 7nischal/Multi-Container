{
    "AWSEBDockerrunVersion": 2,
    "containerDefinitions": [
        {
            "name": "client",
            "image": "7nischal/complex-client",
            "hostname": "client",
            "essential": false
        },

        {
            "name": "server",
            "image": "7nischal/complex-api",
            "hostname": "api",
            "essential": false
            
        },
        {
            "name": "worker",
            "image": "7nischal/complex-worker",
            "hostname": "worker",
            "essential": false
        },
        {
            "name": "nginx",
            "image": "7nischal/complex-nginx",
            "hostname": "nginx",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80
                }
            ],
            "links": [
                "client",
                "server"
            ]
        }
    ]
}